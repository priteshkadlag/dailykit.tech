# Public URL used for canonical links, sitemap.xml, robots.txt, Open Graph tags and email links.
NEXT_PUBLIC_SITE_URL=https://example.com
# Support address shown on the contact, pricing and privacy pages.
NEXT_PUBLIC_SUPPORT_EMAIL=pritkadlag@gmail.com
# Google Tag Manager container (optional; defaults to GTM-W54M67CV). Loads in production builds only.
# NEXT_PUBLIC_GTM_ID=GTM-W54M67CV
# Google AdSense publisher id (optional; defaults to ca-pub-8697520535441690). Loads in production builds only,
# never for Pro accounts. Keep public/ads.txt in step if you change it.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-8697520535441690

# PostgreSQL connection string (Neon, Supabase, RDS, a local install, or `npx prisma dev`).
DATABASE_URL="postgresql://user:password@host:5432/dailykit?sslmode=require"
# Only for the local `npm run db:dev` database, which needs a single connection:
# DATABASE_POOL_MAX=1

# Behind a proxy / on your own server (not Vercel), let Auth.js trust the Host header:
AUTH_TRUST_HOST=true

# Session encryption key. Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Google sign-in (optional — the "Continue with Google" button appears only when both are set).
# Authorised redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated emails that become admins when they sign up or sign in.
ADMIN_EMAILS=

# Outgoing email for password resets, e.g. smtps://user:pass@smtp.zoho.in:465
# Without it, reset links are printed to the server console in development only.
SMTP_URL=
EMAIL_FROM="DailyKit <no-reply@example.com>"

# Secret mixed into hashed rate-limit keys (defaults to AUTH_SECRET).
RATE_LIMIT_SALT=
